# Maintainer: somework <https://github.com/somework/dsx>
pkgname=dsx-bin
pkgver=0.1.2
pkgrel=1
pkgdesc="Sync files between a Claude Design project and a local directory, without the bytes passing through a model's context"
arch=('x86_64' 'aarch64')
url="https://github.com/somework/dsx"
license=('MIT')
provides=('dsx')
conflicts=('dsx')
options=('!strip')
source_x86_64=("dsx-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/dsx_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("dsx-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/dsx_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('288e5f68ef6bb5751837ba47e19406b4611a504a449d040b732161c4d4d57fd5')
sha256sums_aarch64=('076f6a2aa08444e9f0c38d97c12786f786c8cbe1c76ff5d0d6b151f9ea5fff85')

package() {
	install -Dm755 dsx "${pkgdir}/usr/bin/dsx"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

	# Shell completions, generated by the shipped binary (offline, no network, no auth).
	./dsx completion bash | install -Dm644 /dev/stdin "${pkgdir}/usr/share/bash-completion/completions/dsx"
	./dsx completion zsh  | install -Dm644 /dev/stdin "${pkgdir}/usr/share/zsh/site-functions/_dsx"
	./dsx completion fish | install -Dm644 /dev/stdin "${pkgdir}/usr/share/fish/vendor_completions.d/dsx.fish"
}
